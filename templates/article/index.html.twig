
{% extends 'base.html.twig' %}

{% block title %}Nos articles | Blogify{% endblock %}

{% block body %}
    <main class="container py-5">
        <h1 class="mb-4">Nos articles</h1>

        {% for article in articles %}
            <article class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">
                        {{ article.title }}
                    </h2>

                    <p class="text-muted">
                        Publié le
                        {{ article.publishedAt|date('d/m/Y') }}
                    </p>

                    <p class="card-text">
                        {{ article.excerpt }}
                    </p>
                </div>
            </article>
        {% else %}
            <p>Aucun article disponible pour le moment.</p>
        {% endfor %}
    </main>
{% endblock %}
