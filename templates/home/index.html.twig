
{% extends 'base.html.twig' %}

{% block title %}Accueil — Blogify{% endblock %}

{% block body %}

<section class="container py-5">
    <div class="row align-items-center py-lg-5">
        <div class="col-lg-8">
            <span class="badge text-bg-primary mb-3">
                BIENVENUE SUR BLOGIFY
            </span>

            <h1 class="display-3 fw-bold mb-4">
                Des idées à découvrir,
                <span class="text-primary">des histoires à partager.</span>
            </h1>

            <p class="lead text-secondary mb-4">
                Explore des articles, découvre de nouvelles idées
                et partage tes connaissances avec notre communauté.
            </p>

            <a href="#articles" class="btn btn-primary btn-lg px-4">
                Explorer les articles
            </a>
        </div>
    </div>
</section>

<section id="articles" class="container py-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <p class="text-primary fw-semibold mb-2">NOTRE SÉLECTION</p>
            <h2 class="fw-bold mb-0">Articles récents</h2>
        </div>
    </div>

    <div class="row g-4">
        {% for article in articles %}
            <div class="col-md-6 col-lg-4">
                <article class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <span class="badge text-bg-light mb-3">
                            {{ article.category }}
                        </span>

                        <h3 class="h4 fw-bold">
                            {{ article.title }}
                        </h3>

                        <p class="text-secondary">
                            {{ article.excerpt }}
                        </p>

                        <a href="#"
                           class="text-primary fw-semibold text-decoration-none">
                            Lire l'article →
                        </a>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-light border">
                    Aucun article pour le moment. Reviens bientôt !
                </div>
            </div>
        {% endfor %}
    </div>
</section>

<section id="about" class="container py-5">
    <div class="bg-white border rounded-4 p-4 p-lg-5">
        <h2 class="fw-bold">À propos de Blogify</h2>
        <p class="text-secondary mb-0">
            Blogify est un espace de partage de connaissances,
            d'expériences et d'idées.
        </p>
    </div>
</section>

{% endblock %}
