
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Blogify{% endblock %}</title>

    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3" href="{{ path('app_home') }}">
                Blogify<span class="text-primary">.</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">
                            Accueil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#articles">
                            Articles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('article_new') }}" class="btn btn-primary">
                            Ajouter un article
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-white border-top py-4 mt-5">
        <div class="container text-center text-secondary">
            <p class="mb-0">
                &copy; {{ "now"|date("Y") }} Blogify. Tous droits réservés.
            </p>
        </div>
    </footer>

</body>
</html>
